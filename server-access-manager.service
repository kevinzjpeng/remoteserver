[Unit]
Description=Server Access Manager (Rust)
After=network.target

[Service]
Type=simple
User=dev
WorkingDirectory=/home/dev/projects/remoteserver
ExecStart=/home/dev/projects/remoteserver/target/release/server-access-manager
Restart=always
RestartSec=10
StandardOutput=append:/home/dev/projects/remoteserver/server.log
StandardError=append:/home/dev/projects/remoteserver/server.log

# Environment variables
EnvironmentFile=/home/dev/projects/remoteserver/.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
